[package]
authors = ["drbh"]
categories = ["command-line-utilities", "science"]
description = "High-performance FASTQ preprocessing tool - often faster than fastp with the same interface"
documentation = "https://drbh.github.io/fasterp/"
edition = "2021"
homepage = "https://drbh.github.io/fasterp/"
keywords = ["bioinformatics", "fastq", "genomics", "preprocessing", "quality-control"]
license = "MIT"
name = "fasterp"
readme = "README.md"
repository = "https://github.com/drbh/fasterp"
version = "0.2.1"

[features]
default = ["native"]
native = [
  "dep:crossbeam-channel",
  "dep:num_cpus",
  "dep:rayon",
  "dep:aws-sdk-s3",
  "dep:aws-config",
  "dep:tokio",
  "dep:ureq",
  "dep:libdeflater",
  "dep:gzp",
  "flate2/zlib-ng",
]
wasm = ["dep:wasm-bindgen", "dep:js-sys", "flate2/rust_backend"]

[dependencies]
anyhow = "1.0.104"
clap = {version = "4.6.7", features = ["derive"]}
flate2 = {version = "1.1.10", default-features = false}
indexmap = {version = "2.14.2", features = ["serde"]}
memchr = "2.8.3"
once_cell = "1.21.4"
rustc-hash = "2.1.3"
serde = {version = "1.0.229", features = ["derive"]}
serde_json = "1.0.154"

# Native-only dependencies (threading, networking, optimized compression)
aws-config = {version = "1.13.0", optional = true}
aws-sdk-s3 = {version = "1.157.0", optional = true}
crossbeam-channel = {version = "0.5.17", optional = true}
gzp = {version = "2.0.4", features = ["deflate_rust"], default-features = false, optional = true}
libdeflater = {version = "1.26.1", optional = true}
num_cpus = {version = "1.17.0", optional = true}
rayon = {version = "1.12.0", optional = true}
tokio = {version = "1.54.1", features = ["rt-multi-thread"], optional = true}
ureq = {version = "3.5.0", default-features = false, features = ["rustls"], optional = true}

# WASM-only dependencies
js-sys = {version = "0.3.107", optional = true}
wasm-bindgen = {version = "0.2.130", optional = true}

# Optional features
zstd = {version = "0.14.3", optional = true}

[lib]
crate-type = ["cdylib", "rlib"]

[dev-dependencies]
assert_cmd = "2.2.2"
criterion = "0.8.2"
predicates = "3.1.4"
rand = "0.10.3"
tempfile = "3.27.0"

[profile.release]
codegen-units = 1 # Better optimization (slower compile, faster runtime)
lto = "fat" # Full Link Time Optimization across all crates
opt-level = 3 # Maximum optimization
overflow-checks = false # Disable integer overflow checks for performance
panic = "abort" # Smaller/faster code by not unwinding
strip = false # Keep debug symbols for profiling (change to true for production)
